<Window x:Class="SparkingUnverum.UI.ReShadeSlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SparkingUnverum"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}" Icon="../Assets/app.ico"
        Background="#202020" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="Height" Width="480">
    <StackPanel Margin="14,12,14,14">
        <TextBlock Name="IntroText" Foreground="#c2c2c2" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Foreground="#f2f2f2" FontWeight="Bold" Text="{l:Tr Edit.Name}"/>
        <TextBox Name="NameBox" Height="26" Margin="0,4,0,0" Background="#303030" BorderBrush="#353535" Foreground="#f2f2f2" VerticalContentAlignment="Center"/>
        <TextBlock Foreground="#f2f2f2" FontWeight="Bold" Text="{l:Tr ReShade.Notes}" Margin="0,10,0,0"/>
        <TextBox Name="NotesBox" Height="60" Margin="0,4,0,0" Background="#303030" BorderBrush="#353535" Foreground="#f2f2f2"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Name="ErrorText" Foreground="#FFB0B0" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Click="Confirm_Click" Foreground="#f2f2f2" Height="30" MinWidth="120" Margin="0,0,20,0" Content="{l:Tr Common.Confirm}" IsDefault="True"/>
            <Button Click="Cancel_Click" Foreground="#f2f2f2" Height="30" MinWidth="120" Content="{l:Tr Common.Cancel}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
