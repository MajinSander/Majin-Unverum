<Window x:Class="SparkingUnverum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:SparkingUnverum"
        xmlns:ui="clr-namespace:SparkingUnverum.UI"
        Background="#131313" Icon="../Assets/app.ico"
        Title="Majin Unverum" SizeChanged="OnResize"
        mc:Ignorable="d" Closing="Window_Closing" WindowStartupLocation="CenterScreen"
        Height="750" Width="1280" MinHeight="700" MinWidth="1180" Loaded="WindowLoaded" KeyDown="Window_KeyDown">
    <Window.Resources>
        <FontFamily x:Key="Monospace">../Assets/#Roboto Mono</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Thin tabs next to the list that open the organizer and the roster -->
        <Style x:Key="ThinTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBack" CornerRadius="0,4,4,0" Background="#262626">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBack" Property="Background" Value="#C25E0C"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBack" Property="Background" Value="#C25E0C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBack" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ModTemplate">
            <Border CornerRadius="5" Margin="5">
                <Border.Background>
                    <SolidColorBrush Color="#101010" Opacity="0.75"/>
                </Border.Background>
                <Grid VerticalAlignment="Center" Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview, hidden behind a label for spoilers and NSFW -->
                    <TextBlock VerticalAlignment="Center" Panel.ZIndex="4" FontSize="40" FontWeight="Medium" HorizontalAlignment="Center" Foreground="#f2f2f2">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsSpoiler}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="SPOILER"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=IsNsfw}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="NSFW"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Rectangle Height="172" Panel.ZIndex="3" Fill="#202020" Opacity="0.99" Margin="5,10,5,5" VerticalAlignment="Center">
                        <Rectangle.Style>
                            <Style TargetType="{x:Type Rectangle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsSpoiler}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=IsNsfw}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <Image Margin="5,10,5,5" Source="{Binding Path=Image,Mode=OneWay,IsAsync=True}" Height="168" Panel.ZIndex="2" VerticalAlignment="Center" Stretch="Uniform"/>
                    <Rectangle Height="168" Panel.ZIndex="1" Fill="Black" Stretch="UniformToFill" Margin="5,10,5,5" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding Path=Image,Mode=OneWay,IsAsync=True}"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <fa5:ImageAwesome Foreground="{StaticResource AccentBrush}" Grid.Row="0" Icon="Solid_Spinner" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" Spin="True" SpinDuration="2"/>
                    <!-- Installed (or with a newer version), and new since the last visit -->
                    <StackPanel Grid.Row="0" Panel.ZIndex="5" Margin="10,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border Padding="8,3" CornerRadius="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,4"
                                Visibility="{Binding ShowInstalled, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Check" Height="11" Foreground="White" Margin="0,0,5,0"/>
                                <TextBlock Text="{l:Tr Browser.Installed}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="8,3" CornerRadius="3" Background="#2D6FA3" HorizontalAlignment="Left" Margin="0,0,0,4" ToolTip="{l:Tr Browser.NewVersionTooltip}"
                                Visibility="{Binding HasModUpdate, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_ArrowCircleUp" Height="11" Foreground="White" Margin="0,0,5,0"/>
                                <TextBlock Text="{l:Tr Browser.NewVersion}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="8,3" CornerRadius="3" Background="#2E8B57" HorizontalAlignment="Left" Margin="0,0,0,4" ToolTip="{l:Tr Browser.NewSinceTooltip}"
                                Visibility="{Binding IsNewSinceVisit, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Tr Browser.NewSince}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border Padding="8,3" CornerRadius="3" Background="#3B7F86" HorizontalAlignment="Left" Margin="0,0,0,4" ToolTip="{l:Tr Browser.UpdatedSinceTooltip}"
                                Visibility="{Binding IsUpdatedSinceVisit, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Tr Browser.UpdatedSince}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <!-- Favorite -->
                    <Button Grid.Row="0" Panel.ZIndex="5" Margin="0,14,10,0" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Favorite_Click"
                            Visibility="{Binding CanBeFavorite, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:Tr Browser.FavoriteTooltip}"
                            AutomationProperties.Name="{l:Tr Browser.Favorite}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="16" Background="#B0101010">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <fa5:ImageAwesome Height="16">
                            <fa5:ImageAwesome.Style>
                                <Style TargetType="fa5:ImageAwesome">
                                    <Setter Property="Icon" Value="Regular_Star"/>
                                    <Setter Property="Foreground" Value="#f2f2f2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Icon" Value="Solid_Star"/>
                                            <Setter Property="Foreground" Value="#F2C94C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fa5:ImageAwesome.Style>
                        </fa5:ImageAwesome>
                    </Button>

                    <TextBlock Margin="5" Grid.Row="1" FontWeight="Medium" TextTrimming="WordEllipsis" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=Title}" ToolTip="{Binding Path=Title}"/>
                    <StackPanel Grid.Row="2" Margin="10,-5,10,5" Orientation="Horizontal">
                        <Image VerticalAlignment="Center" Source="{Binding Path=Owner.Avatar}" Margin="0,0,10,0" Height="35"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#909090" Text="{Binding Path=Owner.Name}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Owner.HasUpic}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image VerticalAlignment="Center" Source="{Binding Path=Owner.Upic}" Height="25"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image VerticalAlignment="Center" Source="{Binding Path=Category.Icon}" Margin="0,0,8,0" Stretch="Uniform" Height="25" Width="25"/>
                            <TextBlock VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=CategoryName}" TextTrimming="WordEllipsis"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#909090" Text="{Binding Path=VersionString}"/>
                        </StackPanel>
                        <!-- What it needs, read after the page is shown -->
                        <TextBlock Margin="10,2,10,0" HorizontalAlignment="Center" Foreground="#E0B050" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Text="{Binding RequirementsText}" ToolTip="{Binding RequirementsText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RequirementsText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Background="Transparent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="4" ToolTip="{Binding Path=StatsTooltip}">
                        <fa5:ImageAwesome Margin="0,0,5,0" Height="15" Icon="Solid_Heart" Foreground="#f2f2f2"/>
                        <TextBlock Margin="5,0,10,0" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=LikeString}" />
                        <fa5:ImageAwesome Margin="5,0,5,0" Height="15" Icon="Solid_Eye" Foreground="#f2f2f2"/>
                        <TextBlock Margin="5,0,10,0" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=ViewString}" />
                        <fa5:ImageAwesome Margin="5,0,5,0" Height="15" Icon="Solid_Comment" Foreground="#f2f2f2"/>
                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=PostString}" />
                    </StackPanel>
                    <StackPanel Grid.Row="5" Margin="0,5,0,5" HorizontalAlignment="Center">
                        <StackPanel Background="Transparent" Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Binding Path=DateAddedTooltip}">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HasUpdates}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <fa5:ImageAwesome Margin="0,0,5,0" Height="15" Icon="Solid_Plus" Foreground="#f2f2f2"/>
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=DateAddedFormatted}" />
                        </StackPanel>
                        <StackPanel Background="Transparent" Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Binding Path=DateUpdatedTooltip}">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HasUpdates}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <fa5:ImageAwesome Margin="0,0,5,0" Height="15" Icon="Solid_Sync" Foreground="#f2f2f2"/>
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=DateUpdatedAgo}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="6" Margin="5,5,5,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Foreground="#f2f2f2" FontWeight="Medium" Height="30" Width="105" Background="#303030" BorderBrush="#353535" Content="{l:Tr Browser.MoreInfo}" Click="MoreInfo_Click"/>
                        <Button Grid.Column="1" Foreground="#f2f2f2" FontWeight="Medium" Height="30" Width="105" Background="#303030" BorderBrush="#353535" IsEnabled="{Binding Path=Compatible}" Click="Download_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="{l:Tr Browser.Download}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasModUpdate}" Value="True">
                                            <Setter Property="Content" Value="{l:Tr Browser.UpdateMod}"/>
                                            <Setter Property="ToolTip" Value="{l:Tr Browser.UpdateModTooltip}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- Top right corner, next to the tabs -->
        <StackPanel Panel.ZIndex="3" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
            <TextBox BorderThickness="0" FontSize="16" Margin="5" Background="Transparent" BorderBrush="Transparent" IsReadOnly="True" Foreground="#c2c2c2" FontWeight="Medium" Name="Stats" VerticalAlignment="Center"/>
            <Button Name="HistoryButton" Click="History_Click" Margin="5,3,0,3" Height="30" Padding="8,0" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2"
                    ToolTip="{l:Tr History.ButtonTooltip}" AutomationProperties.Name="{l:Tr History.Button}">
                <StackPanel Orientation="Horizontal">
                    <fa5:ImageAwesome Icon="Solid_History" Height="15" Foreground="#f2f2f2" Margin="0,0,6,0"/>
                    <TextBlock Text="{l:Tr History.Button}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="ShareButton" Click="Share_Click" Margin="5,3,0,3" Height="30" Padding="8,0" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2"
                    ToolTip="{l:Tr Share.ButtonTooltip}" AutomationProperties.Name="{l:Tr Share.Button}">
                <StackPanel Orientation="Horizontal">
                    <fa5:ImageAwesome Icon="Solid_ShareAlt" Height="15" Foreground="#f2f2f2" Margin="0,0,6,0"/>
                    <TextBlock Text="{l:Tr Share.Button}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="ReShadeButton" Click="ReShade_Click" Margin="5,3,0,3" Height="30" Padding="8,0" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2"
                    ToolTip="{l:Tr ReShade.ButtonTooltip}" AutomationProperties.Name="{l:Tr ReShade.Button}">
                <StackPanel Orientation="Horizontal">
                    <fa5:ImageAwesome Icon="Solid_Magic" Height="15" Foreground="#f2f2f2" Margin="0,0,6,0"/>
                    <TextBlock Text="{l:Tr ReShade.Button}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="SettingsButton" Click="Settings_Click" Margin="5,3,8,3" Height="30" Padding="8,0" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2" ToolTip="{l:Tr Main.Settings}">
                <StackPanel Orientation="Horizontal">
                    <fa5:ImageAwesome Icon="Solid_Cog" Height="16" Foreground="#f2f2f2" Margin="0,0,6,0"/>
                    <TextBlock Text="{l:Tr Main.Settings}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <TabControl Background="#202020" BorderBrush="#353535">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="Border" Width="Auto" MinWidth="100" MinHeight="30" VerticalAlignment="Bottom"
                                        Background="#1d1d1d" BorderBrush="#353535" BorderThickness="0" CornerRadius="6,6,0,0" Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite" Margin="10,3,10,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      ContentSource="Header" TextElement.FontWeight="Medium" TextElement.FontSize="15pt" TextElement.Foreground="#f2f2f2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#353535" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#353535" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Mod manager -->
            <TabItem Name="ModManager" Selector.Selected="OnManagerTabSelected" FontSize="18" Header="{l:Tr Main.ManageTab}">
                <Grid Name="MainGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="1.6*" MinHeight="100"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition MinHeight="100"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Margin="10,0,0,0" Height="35" CornerRadius="3" Background="#181818" BorderBrush="#252525" BorderThickness="1" ToolTip="{x:Static l:SparkingGame.DisplayName}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,10,0">
                            <Image Source="../Assets/Icons/DBSZ.jpg" Width="27" Margin="0,0,8,0"/>
                            <TextBlock Text="Sparking! ZERO" VerticalAlignment="Center" FontWeight="Medium" FontSize="16" Foreground="#f2f2f2"/>
                        </StackPanel>
                    </Border>
                    <ComboBox Grid.Column="1" Margin="10,0,10,0" Height="35" FontSize="16" FontWeight="Medium" Name="LoadoutsBox" SelectionChanged="LoadoutsBox_SelectionChanged" ToolTip="{l:Tr Main.LoadoutTooltip}"/>
                    <Button FontSize="16" FontWeight="Medium" Name="EditLoadoutsButton" Margin="0,0,10,0" Height="35" Grid.Column="2" Content="{l:Tr Main.EditLoadouts}" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2" Click="EditLoadouts_Click" />
                    <Button FontSize="16" FontWeight="Medium" Name="ConfigButton" Margin="0,0,10,0" Height="35" Grid.Column="3" Content="{l:Tr Main.Setup}" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2" Click="Setup_Click" ToolTip="{l:Tr Main.SetupTooltip}"/>
                    <Border Grid.Column="4" Margin="0,0,10,0" Height="35" CornerRadius="3" Background="{StaticResource AccentBrush}">
                        <Button FontSize="16" FontWeight="SemiBold" Name="LaunchButton" Margin="2" Content="{l:Tr Main.Launch}" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2" Click="Launch_Click" ToolTip="{l:Tr Main.LaunchTooltip}"/>
                    </Border>
                    <ComboBox Grid.Column="5" Margin="0,0,10,0" Height="35" FontSize="16" FontWeight="Medium" Name="LauncherOptionsBox" SelectionChanged="LauncherOptionsBox_SelectionChanged" ToolTip="{l:Tr Main.LaunchMethodTooltip}"/>
                    <Button FontSize="16" FontWeight="Medium" Name="OpenModsButton" Margin="0,0,10,0" Height="35" Grid.Column="6" Content="{l:Tr Main.AddMods}" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2" Click="ModsFolder_Click"/>
                    <Button FontSize="16" FontWeight="Medium" Name="UpdateButton" Margin="0,0,10,0" Height="35" Grid.Column="7" Content="{l:Tr Main.UpdateMods}" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2" Click="Update_Click"/>

                    <Grid Name="MiddleGrid" Grid.Row="1" Grid.ColumnSpan="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid Visibility="Collapsed" Grid.Row="1" Name="DropBox" Margin="10,5,3,3" Panel.ZIndex="2" DragLeave="Add_Leave" DragEnter="Add_Enter" Drop="Add_Drop" AllowDrop="True" Background="Transparent">
                            <Border Opacity="0.7" Background="Black"/>
                            <TextBlock Foreground="#f2f2f2" FontSize="34" Panel.ZIndex="3" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{l:Tr Main.DropFiles}"/>
                        </Grid>
                        <ComboBox Name="ModFilterBox" Panel.ZIndex="2" Margin="0,5,3,5" Height="35" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  FontSize="14" SelectionChanged="ModFilterBox_SelectionChanged" ToolTip="{l:Tr Main.FilterTooltip}">
                            <ComboBoxItem IsSelected="True" Content="{l:Tr Main.FilterAll}"/>
                            <ComboBoxItem Content="{l:Tr Main.FilterEnabled}"/>
                            <ComboBoxItem Content="{l:Tr Main.FilterDisabled}"/>
                            <ComboBoxItem Content="{l:Tr Main.FilterUpdates}"/>
                            <ComboBoxItem Content="{l:Tr Main.FilterUnavailable}"/>
                            <ComboBoxItem Content="{l:Tr Main.FilterUnlinked}"/>
                        </ComboBox>
                        <Grid Panel.ZIndex="2" Margin="10,5,208,5" Height="35" VerticalAlignment="Center">
                            <TextBox Margin="0,0,35,0" Background="#353535" Foreground="#f2f2f2" BorderBrush="#353535" x:Name="ModGrid_SearchBar" KeyDown="ModGrid_SearchBar_KeyDown" TextChanged="ModGrid_SearchBar_TextChanged" Padding="5" TextWrapping="NoWrap"/>
                            <TextBlock Padding="8,5,5,5" Foreground="#a2a2a2" Panel.ZIndex="3" IsHitTestVisible="False" Height="35" HorizontalAlignment="Left" Text="{l:Tr Main.SearchMods}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ModGrid_SearchBar, Path=Text.IsEmpty}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <fa5:ImageAwesome Icon="Solid_Times" Foreground="#f2f2f2" HorizontalAlignment="Right" Margin="6,6,40,6" Height="15" PreviewMouseLeftButtonDown="Clear_PreviewMouseLeftButtonDown">
                                <fa5:ImageAwesome.Style>
                                    <Style TargetType="fa5:ImageAwesome">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ModGrid_SearchBar, Path=Text.IsEmpty}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=ModGrid_SearchBar, Path=Text.IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </fa5:ImageAwesome.Style>
                            </fa5:ImageAwesome>
                            <Button HorizontalAlignment="Right" Panel.ZIndex="3" Focusable="False" Click="ModGridSearchButton_Click" Name="ModGridSearchButton" Height="35" Width="35">
                                <fa5:ImageAwesome Icon="Solid_Search" Foreground="#f2f2f2" Margin="3"/>
                            </Button>
                        </Grid>
                        <!-- Thin tabs that open the organizer and the roster -->
                        <!-- Real buttons: keyboard, screen readers and automation can press them -->
                        <Grid Grid.Row="1" HorizontalAlignment="Right" Width="22" Margin="0,5,2,3">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="4"/>
                                <RowDefinition/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button Name="CategoriesTab" Style="{StaticResource ThinTab}"
                                    ToolTip="{l:Tr Main.CategoriesTooltip}" AutomationProperties.Name="{l:Tr Main.CategoriesTab}" Click="CategoriesTab_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <fa5:ImageAwesome Icon="Solid_LayerGroup" Height="11" Foreground="#c2c2c2" Margin="0,0,0,8"/>
                                    <TextBlock Text="{l:Tr Main.CategoriesTab}" Foreground="#c2c2c2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="90"/>
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Name="RosterTab" Grid.Row="2" Style="{StaticResource ThinTab}"
                                    ToolTip="{l:Tr Roster.TabTooltip}" AutomationProperties.Name="{l:Tr Roster.Tab}" Click="RosterTab_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <fa5:ImageAwesome Icon="Solid_UserFriends" Height="11" Foreground="#c2c2c2" Margin="0,0,0,8"/>
                                    <TextBlock Text="{l:Tr Roster.Tab}" Foreground="#c2c2c2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="90"/>
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <!-- Field of view (SparkingFOV mod, see SparkingFov.cs) -->
                            <Button Name="FovTab" Grid.Row="4" Height="46" Style="{StaticResource ThinTab}"
                                    ToolTip="{l:Tr Fov.TabTooltip}" AutomationProperties.Name="{l:Tr Fov.Tab}" Click="FovTab_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <fa5:ImageAwesome Icon="Solid_Eye" Height="10" Foreground="#c2c2c2" Margin="0,0,0,5"/>
                                    <TextBlock Text="{l:Tr Fov.Tab}" Foreground="#c2c2c2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="90"/>
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <DataGrid Grid.Row="1" DragEnter="Add_Enter" Margin="10,5,26,3" Name="ModGrid" AutoGenerateColumns="False" GridLinesVisibility="None" VerticalScrollBarVisibility="Auto" BorderBrush="#424242"
                                  EnableColumnVirtualization="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  CanUserResizeColumns="False" CanUserResizeRows="False" CanUserSortColumns="False" AlternatingRowBackground="#2A2A2A"
                                  dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" HeadersVisibility="Column"
                                  SelectionMode="Extended" RowBackground="#202020" Foreground="#f2f2f2" LoadingRow="ModGrid_LoadingRow" HorizontalScrollBarVisibility="Hidden"
                                  Background="#202020" FontSize="12" PreviewKeyDown="ModGrid_PreviewKeyDown"
                                  ContextMenuOpening="ModGrid_ContextMenuOpening" SelectionChanged="ModGrid_SelectionChanged">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#C25E0C"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#f2f2f2"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C25E0C" />
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#303030" />
                                    <Setter Property="Foreground" Value="#f2f2f2"/>
                                    <Setter Property="Height" Value="19"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="ToolTip" Value="{l:Tr Main.HeaderTooltip}"/>
                                    <EventSetter Event="Click" Handler="SortAlphabeticallyAndGroupEnabled_Click"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Tr Main.FetchMetadata}" Click="FetchItem_Click"/>
                                    <MenuItem Header="{l:Tr Main.RenameMod}" Click="EditItem_Click"/>
                                    <MenuItem Header="{l:Tr Main.ConfigurePaks}" Click="ConfigurePaksItem_Click"/>
                                    <MenuItem Header="{l:Tr Main.OpenModFolder}" Click="OpenItem_Click"/>
                                    <MenuItem Header="{l:Tr Main.OpenModPage}" Click="OpenPageItem_Click"/>
                                    <MenuItem Header="{l:Tr Main.DeleteMod}" Click="DeleteItem_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{l:Tr Main.EnabledColumn}" Binding="{Binding enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="Auto" MinWidth="60">
                                    <DataGridCheckBoxColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <EventSetter Event="CheckBox.Checked" Handler="OnChecked"/>
                                            <EventSetter Event="CheckBox.Unchecked" Handler="OnUnchecked"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="IsEditing" Value="True" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridCheckBoxColumn.CellStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Header="{l:Tr Main.NameColumn}" Binding="{Binding name, Mode=TwoWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="{l:Tr Main.SizeColumn}" Binding="{Binding SizeText}" IsReadOnly="True" Width="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#a2a2a2"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Background="Transparent" ToolTip="{Binding StateTooltip}">
                                                <fa5:ImageAwesome Icon="Solid_ArrowCircleUp" Height="13" Foreground="{StaticResource AccentBrush}">
                                                    <fa5:ImageAwesome.Style>
                                                        <Style TargetType="fa5:ImageAwesome">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa5:ImageAwesome.Style>
                                                </fa5:ImageAwesome>
                                                <fa5:ImageAwesome Icon="Solid_ExclamationTriangle" Height="12" Foreground="#909090">
                                                    <fa5:ImageAwesome.Style>
                                                        <Style TargetType="fa5:ImageAwesome">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Unavailable">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa5:ImageAwesome.Style>
                                                </fa5:ImageAwesome>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="10" Background="Transparent"/>
                        <Grid Grid.Column="2" Grid.RowSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.5*"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Image Margin="3,3,10,5" Name="Preview" Grid.Row="0" Panel.ZIndex="2"/>
                            <Image Margin="3,3,10,5" Name="PreviewBG" Grid.Row="0" Stretch="UniformToFill" Panel.ZIndex="1">
                                <Image.Effect>
                                    <BlurEffect Radius="40"/>
                                </Image.Effect>
                            </Image>
                            <fa5:ImageAwesome Foreground="{StaticResource AccentBrush}" Grid.Row="0" Icon="Solid_Spinner" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" Spin="True" SpinDuration="2"/>
                            <RichTextBox FontSize="12" Padding="10" Grid.Row="1" Margin="3,5,10,3" Name="DescriptionWindow" Foreground="#F2F2F2" Background="#202020" BorderBrush="#424242"
                                         VerticalScrollBarVisibility="Auto" IsReadOnly="True" IsDocumentEnabled="True" FontWeight="Medium"/>
                        </Grid>
                    </Grid>
                    <GridSplitter Grid.Row="2" Grid.ColumnSpan="8" HorizontalAlignment="Stretch" Height="10" Background="Transparent" />
                    <!-- Organizer of categories, over everything below the buttons -->
                    <ui:CategoriesPanel x:Name="CategoriesPanel" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="8" Panel.ZIndex="10" Margin="10,0,10,10" Visibility="Collapsed"/>
                    <!-- Characters and costumes of the select screen, also over everything below the buttons -->
                    <ui:RosterPanel x:Name="RosterPanel" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="8" Panel.ZIndex="10" Margin="10,0,10,10" Visibility="Collapsed"/>

                    <RichTextBox FontFamily="{StaticResource Monospace}" FontSize="12" Margin="10,3,10,10" Name="ConsoleWindow" Background="#202020" BorderBrush="#424242" Grid.Row="3" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Grid.ColumnSpan="8" TextChanged="ScrollToBottom">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Grid>
            </TabItem>

            <!-- GameBanana browser -->
            <TabItem Name="ModBrowser" Selector.Selected="OnBrowserTabSelected" FontSize="18" Header="{l:Tr Main.BrowseTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Full size screenshots -->
                    <Grid Grid.RowSpan="3" Grid.ColumnSpan="7" Name="MediaPanel" Panel.ZIndex="5" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="90"/>
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Panel.ZIndex="-1">
                            <Border.Background>
                                <SolidColorBrush Color="#080808" Opacity="0.95"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="10" VerticalAlignment="Center" Grid.Row="0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.15*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.15*"/>
                                </Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ImageLeft_Click" Name="BigImageLeft" Content="&lt;" Height="50" Width="50" FontWeight="SemiBold" FontSize="20"/>
                                <Image Grid.Column="1" Name="BigScreenshot" Stretch="Uniform" Margin="20,0,20,0" VerticalAlignment="Center"/>
                                <fa5:ImageAwesome Panel.ZIndex="-1" Grid.Column="1" Foreground="{StaticResource AccentBrush}" Icon="Solid_Spinner" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center" Spin="True" SpinDuration="2"/>
                                <Button Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Click="ImageRight_Click" Name="BigImageRight" Content=">" Height="50" Width="50" FontWeight="SemiBold" FontSize="20"/>
                            </Grid>
                            <TextBlock Name="BigCaptionText" HorizontalAlignment="Center" FontSize="18" Foreground="#f2f2f2" Padding="5"/>
                        </StackPanel>
                        <StackPanel Margin="20" Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="CloseMedia_Click" Content="{l:Tr Common.Close}" Height="50" Width="200" FontSize="20" FontWeight="SemiBold" Foreground="#f2f2f2"/>
                        </StackPanel>
                    </Grid>

                    <!-- More info about a mod -->
                    <Grid Grid.ColumnSpan="7" Grid.RowSpan="3" Name="DescPanel" Panel.ZIndex="4" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition/>
                            <RowDefinition Height="90"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="-1">
                            <Border.Background>
                                <SolidColorBrush Color="#080808" Opacity="0.95"/>
                            </Border.Background>
                        </Border>
                        <DockPanel Grid.ColumnSpan="2">
                            <!-- Favorite and follow the author -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,20,0">
                                <Button Name="FavoriteButton" Click="DescFavorite_Click" Margin="0,0,10,0" Height="38" Padding="14,0" FontSize="15" FontWeight="SemiBold" Foreground="#f2f2f2"
                                        Visibility="Collapsed"/>
                                <Button Name="FollowButton" Click="Follow_Click" Height="38" Padding="14,0" FontSize="15" FontWeight="SemiBold" Foreground="#f2f2f2" Visibility="Collapsed"
                                        ToolTip="{l:Tr Browser.FollowTooltip}"/>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" Name="DescTitle" TextTrimming="WordEllipsis" Foreground="#f2f2f2" FontWeight="SemiBold" FontSize="36" Padding="10,3,3,3"/>
                        </DockPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource AccentBrush}"/>
                        <fa5:ImageAwesome Name="DescLoading" Grid.Row="2" Grid.ColumnSpan="2" Foreground="{StaticResource AccentBrush}" Icon="Solid_Spinner" Height="80" VerticalAlignment="Center" HorizontalAlignment="Center" Spin="True" SpinDuration="2"/>
                        <StackPanel Name="ImagePanel" Visibility="Collapsed" VerticalAlignment="Center" Grid.Column="1" Grid.Row="2">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.15*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.15*"/>
                                </Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ImageLeft_Click" Name="ImageLeft" Content="&lt;" Height="50" Width="50" FontWeight="SemiBold" FontSize="20"/>
                                <Image Grid.Column="1" Cursor="Hand" PreviewMouseLeftButtonDown="Image_Click" Name="Screenshot" Stretch="Uniform" MaxHeight="400" Margin="20,0,20,0" VerticalAlignment="Center"/>
                                <fa5:ImageAwesome Panel.ZIndex="-1" Grid.Column="1" Foreground="{StaticResource AccentBrush}" Icon="Solid_Spinner" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center" Spin="True" SpinDuration="2"/>
                                <Button Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Click="ImageRight_Click" Name="ImageRight" Content=">" Height="50" Width="50" FontWeight="SemiBold" FontSize="20"/>
                            </Grid>
                            <TextBlock Name="CaptionText" HorizontalAlignment="Center" FontSize="18" Foreground="#f2f2f2" Padding="5"/>
                        </StackPanel>
                        <RichTextBox Margin="5" Name="DescText" Grid.Row="2" Background="Transparent" BorderThickness="0" IsDocumentEnabled="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Foreground="#f2f2f2" Padding="10,0,10,10" FontSize="17"/>
                        <StackPanel Grid.ColumnSpan="2" Margin="20" Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Name="AltButton" Click="AltDownload_Click" Content="{l:Tr Browser.AltDownloads}" Margin="0,0,20,0" Height="50" Width="220" FontSize="19" FontWeight="SemiBold" Foreground="#f2f2f2"/>
                            <Border Name="DownloadButton" Margin="0,0,20,0" Height="50" Width="220" CornerRadius="2" Background="{StaticResource AccentBrush}">
                                <Button Margin="3" Click="DescDownload_Click" Content="{l:Tr Browser.Download}" FontSize="19" FontWeight="SemiBold" Foreground="#f2f2f2"/>
                            </Border>
                            <Button Name="HomepageButton" Click="Homepage_Click" Content="{l:Tr Browser.OpenPage}" Margin="0,0,20,0" Height="50" Width="220" FontSize="19" FontWeight="SemiBold" Foreground="#f2f2f2"/>
                            <Button Click="CloseDesc_Click" Content="{l:Tr Common.Close}" Height="50" Width="200" FontSize="19" FontWeight="SemiBold" Foreground="#f2f2f2"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filters -->
                    <ComboBox Margin="10,0,0,0" Grid.Column="0" IsEnabled="False" FontWeight="Medium" FontSize="16" Name="TypeBox" Height="35" HorizontalAlignment="Stretch" SelectionChanged="TypeFilterSelectionChanged">
                        <ComboBoxItem IsSelected="True" Content="{l:Tr Browser.TypeMods}"/>
                        <ComboBoxItem Content="{l:Tr Browser.TypeSounds}"/>
                        <ComboBoxItem Content="{l:Tr Browser.TypeWips}"/>
                    </ComboBox>
                    <ComboBox Margin="5,0,0,0" Grid.Column="1" IsEnabled="False" Name="FilterBox" Height="35" HorizontalAlignment="Stretch" FontSize="16" FontWeight="Medium" SelectionChanged="FilterSelectionChanged"/>
                    <ComboBox Margin="5,0,0,0" Grid.Column="2" IsEnabled="False" Name="CatBox" Height="35" HorizontalAlignment="Stretch" SelectionChanged="MainFilterSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Margin="0,0,5,0" VerticalAlignment="Center" Height="25" Source="{Binding Path=Icon}"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Medium" Text="{Binding Path=Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Margin="5,0,0,0" Grid.Column="3" IsEnabled="False" Name="SubCatBox" Height="35" HorizontalAlignment="Stretch" SelectionChanged="SubFilterSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Margin="0,0,5,0" VerticalAlignment="Center" Height="25" Source="{Binding Path=Icon}"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Medium" Text="{Binding Path=Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Grid.Column="4" Margin="5,0,0,0" Height="35">
                        <TextBox Margin="0,0,35,0" Background="#353535" Foreground="#f2f2f2" BorderBrush="#353535" Padding="4,0,0,0" IsEnabled="False" KeyDown="SearchBar_KeyDown" Name="SearchBar" VerticalContentAlignment="Center"/>
                        <TextBlock Padding="7,0,3,0" IsHitTestVisible="False" HorizontalAlignment="Left" Text="{l:Tr Browser.Search}" VerticalAlignment="Center" Foreground="#a2a2a2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=SearchBar, Path=Text.IsEmpty}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button IsEnabled="False" HorizontalAlignment="Right" Click="SearchButton_Click" Name="SearchButton" Height="35" Width="35">
                            <fa5:ImageAwesome Icon="Solid_Search" Foreground="#f2f2f2" Margin="3"/>
                        </Button>
                    </Grid>
                    <CheckBox Grid.Column="5" Name="NSFWCheckbox" IsEnabled="False" Unchecked="LocalFilter_Changed" Checked="LocalFilter_Changed" Margin="12,0,5,0" VerticalAlignment="Center" VerticalContentAlignment="Center">
                        <TextBlock Foreground="#f2f2f2" FontSize="14" FontWeight="Medium" Text="{l:Tr Browser.IncludeNsfw}"/>
                    </CheckBox>
                    <Image Grid.Column="6" Name="GB" Margin="10,0,10,0" VerticalAlignment="Center" Height="35" Source="../Assets/GameBanana.png" Cursor="Hand" MouseLeftButtonDown="GameBanana_Click" ToolTip="{l:Tr Browser.GoToGameBanana}"/>

                    <!-- Bottom bar: filters, pages and options side by side, never on top of each other -->
                    <Grid Grid.ColumnSpan="7" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,5,5,5">
                        <CheckBox Name="ZsJsonCheckbox" IsEnabled="False" Unchecked="LocalFilter_Changed" Checked="LocalFilter_Changed" Margin="0,0,15,0" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <TextBlock Foreground="#f2f2f2" FontSize="14" FontWeight="Medium" Text="{l:Tr Browser.HideZeroSpark}"/>
                        </CheckBox>
                        <CheckBox Name="ColorZCheckbox" IsEnabled="False" Unchecked="LocalFilter_Changed" Checked="LocalFilter_Changed" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <TextBlock Foreground="#f2f2f2" FontSize="14" FontWeight="Medium" Text="{l:Tr Browser.HideColorZ}"/>
                        </CheckBox>
                        <CheckBox Name="HideInstalledCheckbox" IsEnabled="False" Unchecked="LocalFilter_Changed" Checked="LocalFilter_Changed" Margin="15,0,0,0"
                                  VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip="{l:Tr Browser.HideInstalledTooltip}">
                            <TextBlock Foreground="#f2f2f2" FontSize="14" FontWeight="Medium" Text="{l:Tr Browser.HideInstalled}"/>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button IsEnabled="False" Name="PageLeft" Click="DecrementPage" Content="&lt;" Margin="0,0,15,0" FontSize="18" FontWeight="Medium" Height="35" Width="35" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2"/>
                        <TextBlock Name="Page" Foreground="#f2f2f2" VerticalAlignment="Center" FontSize="18" FontWeight="Medium" />
                        <Button IsEnabled="False" Name="PageRight" Click="IncrementPage" Content=">" Margin="15,0,0,0" FontSize="18" FontWeight="Medium" Height="35" Width="35" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2"/>
                        <ComboBox IsEnabled="False" Margin="15,0,15,0" Name="PageBox" SelectionChanged="PageBox_SelectionChanged" Height="35" MinWidth="60" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="5,5,10,5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="0,0,15,0" Click="ClearCache" Name="ClearCacheButton" Content="{l:Tr Browser.Refresh}" FontSize="16" FontWeight="Medium" Height="35" Padding="12,0" Background="#181818" BorderBrush="#252525" IsEnabled="False" Foreground="#f2f2f2"/>
                        <TextBlock Margin="0,0,10,0" Foreground="#f2f2f2" VerticalAlignment="Center" FontSize="16" FontWeight="Medium" Text="{l:Tr Browser.PerPage}"/>
                        <ComboBox IsEnabled="False" Name="PerPageBox" SelectionChanged="PerPageSelectionChanged" Height="35" VerticalAlignment="Center">
                            <ComboBoxItem>10</ComboBoxItem>
                            <ComboBoxItem IsSelected="True">20</ComboBoxItem>
                            <ComboBoxItem>30</ComboBoxItem>
                            <ComboBoxItem>40</ComboBoxItem>
                            <ComboBoxItem>50</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    </Grid>

                    <fa5:ImageAwesome Name="LoadingBar" Grid.ColumnSpan="7" Foreground="{StaticResource AccentBrush}" Panel.ZIndex="1" Grid.Row="1" Icon="Solid_Spinner" Height="110" VerticalAlignment="Center" HorizontalAlignment="Center" Spin="True" SpinDuration="2"/>
                    <StackPanel Name="ErrorPanel" Visibility="Collapsed" Grid.ColumnSpan="7" Grid.Row="1" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Name="BrowserMessage" HorizontalAlignment="Center" Foreground="#f2f2f2" FontWeight="Medium" TextWrapping="Wrap" Width="800" TextAlignment="Center" FontSize="24"/>
                        <Button Margin="10" Click="BrowserRefresh" Name="BrowserRefreshButton" Content="{l:Tr Browser.Retry}" HorizontalAlignment="Center" FontSize="18" FontWeight="Medium" Height="40" Width="160" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2"/>
                    </StackPanel>
                    <Border Grid.ColumnSpan="7" Grid.Row="1" CornerRadius="5" Margin="10,0,10,0">
                        <Border.Background>
                            <SolidColorBrush Color="Black" Opacity="0.75"/>
                        </Border.Background>
                        <ListView Margin="5" Panel.ZIndex="1" Style="{StaticResource ListviewStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Top" VerticalContentAlignment="Top" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderBrush="Transparent" Name="FeedBox" ItemTemplate="{StaticResource ModTemplate}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="false"/>
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid SizeChanged="UniformGrid_SizeChanged"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
