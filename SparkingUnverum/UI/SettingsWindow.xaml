<Window x:Class="SparkingUnverum.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="{l:Tr Settings.Title}" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        ResizeMode="NoResize" Width="560" SizeToContent="Height" Background="#202020">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F28C1E"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="SettingButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#494949"/>
            <Setter Property="Foreground" Value="#f2f2f2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#f2f2f2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,6,16,16">
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Settings.General}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Settings.Language}" Foreground="#f2f2f2" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" Name="LanguageBox" Height="30" FontSize="14" SelectionChanged="LanguageBox_SelectionChanged">
                <ComboBoxItem Tag="es">Español</ComboBoxItem>
                <ComboBoxItem Tag="en">English</ComboBoxItem>
            </ComboBox>
        </Grid>
        <CheckBox Name="AppUpdatesCheckbox" Content="{l:Tr Settings.CheckAppUpdates}" Margin="0,10,0,4"/>
        <CheckBox Name="ModUpdatesCheckbox" Content="{l:Tr Settings.CheckModUpdates}"/>
        <Button Style="{StaticResource SettingButton}" Click="CheckUpdate_Click">
            <StackPanel Orientation="Horizontal">
                <fa5:ImageAwesome Icon="Solid_Sync" Height="14" Foreground="#f2f2f2" Margin="0,0,8,0"/>
                <TextBlock Text="{l:Tr Settings.CheckNow}"/>
            </StackPanel>
        </Button>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Settings.Mods}"/>
        <Button Style="{StaticResource SettingButton}" Click="Import_Click">
            <StackPanel Orientation="Horizontal">
                <fa5:ImageAwesome Icon="Solid_FileImport" Height="14" Foreground="#f2f2f2" Margin="0,0,8,0"/>
                <TextBlock Text="{l:Tr Settings.ImportClassic}"/>
            </StackPanel>
        </Button>
        <Button Style="{StaticResource SettingButton}" Click="Merge_Click">
            <StackPanel Orientation="Horizontal">
                <fa5:ImageAwesome Icon="Solid_ObjectGroup" Height="14" Foreground="#f2f2f2" Margin="0,0,8,0"/>
                <TextBlock Text="{l:Tr Settings.Merge}"/>
            </StackPanel>
        </Button>
        <Button Style="{StaticResource SettingButton}" Click="Backups_Click">
            <StackPanel Orientation="Horizontal">
                <fa5:ImageAwesome Icon="Solid_Broom" Height="14" Foreground="#f2f2f2" Margin="0,0,8,0"/>
                <TextBlock Text="{l:Tr Settings.Backups}"/>
            </StackPanel>
        </Button>
        <Button Style="{StaticResource SettingButton}" Click="RemoveMods_Click">
            <StackPanel Orientation="Horizontal">
                <fa5:ImageAwesome Icon="Solid_Eraser" Height="14" Foreground="#f2f2f2" Margin="0,0,8,0"/>
                <TextBlock Text="{l:Tr Settings.RemoveMods}"/>
            </StackPanel>
        </Button>
        <Button Style="{StaticResource SettingButton}" Click="RegisterLinks_Click">
            <StackPanel Orientation="Horizontal">
                <fa5:ImageAwesome Icon="Solid_Link" Height="14" Foreground="#f2f2f2" Margin="0,0,8,0"/>
                <TextBlock Text="{l:Tr Settings.RegisterLinks}"/>
            </StackPanel>
        </Button>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Settings.Folders}"/>
        <UniformGrid Columns="2">
            <Button Style="{StaticResource SettingButton}" Margin="0,3,4,3" Click="OpenMods_Click" Content="{l:Tr Settings.OpenMods}"/>
            <Button Style="{StaticResource SettingButton}" Margin="4,3,0,3" Click="OpenGame_Click" Content="{l:Tr Settings.OpenGame}"/>
            <Button Style="{StaticResource SettingButton}" Margin="0,3,4,3" Click="OpenBackups_Click" Content="{l:Tr Settings.OpenBackups}"/>
            <Button Style="{StaticResource SettingButton}" Margin="4,3,0,3" Click="OpenLog_Click" Content="{l:Tr Settings.OpenLog}"/>
        </UniformGrid>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Settings.About}"/>
        <TextBlock Name="AboutText" Foreground="#c2c2c2" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock Margin="0,6,0,0" FontSize="14">
            <Hyperlink Name="RepoLink" Foreground="#F28C1E" Click="Repo_Click">
                <Run Text="{x:Static l:SparkingGame.RepositoryUrl}"/>
            </Hyperlink>
        </TextBlock>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr Settings.Credits}"/>
        <TextBlock Name="CreditsFovText" Foreground="#c2c2c2" FontSize="14" TextWrapping="Wrap"/>

        <Button Margin="0,16,0,0" Height="38" FontSize="16" FontWeight="Bold" Background="#494949" Foreground="#f2f2f2" Content="{l:Tr Common.Close}" Click="Close_Click" IsCancel="True"/>
    </StackPanel>
</Window>
