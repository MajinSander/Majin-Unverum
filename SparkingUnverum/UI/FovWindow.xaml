<Window x:Class="SparkingUnverum.UI.FovWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="{l:Tr Fov.Title}" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        ResizeMode="NoResize" Width="480" SizeToContent="Height" Background="#202020">
    <Window.Resources>
        <Style x:Key="FovSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="#a2a2a2"/>
            <Setter Property="TickPlacement" Value="BottomRight"/>
            <Setter Property="TickFrequency" Value="10"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="10"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18,14,18,16">
        <TextBlock Foreground="#c2c2c2" FontSize="13" TextWrapping="Wrap" Text="{l:Tr Fov.Intro}"/>

        <DockPanel Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Right" Name="PercentText" Foreground="#F28C1E" FontSize="16" FontWeight="Bold"/>
            <TextBlock Foreground="#f2f2f2" FontSize="15" FontWeight="SemiBold" Text="{l:Tr Fov.Multiplier}"/>
        </DockPanel>
        <Slider Name="PercentSlider" Style="{StaticResource FovSlider}" ValueChanged="Slider_ValueChanged"
                AutomationProperties.Name="{l:Tr Fov.Multiplier}"/>

        <DockPanel Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Right" Name="MaximumText" Foreground="#F28C1E" FontSize="16" FontWeight="Bold"/>
            <TextBlock Foreground="#f2f2f2" FontSize="15" FontWeight="SemiBold" Text="{l:Tr Fov.Maximum}"/>
        </DockPanel>
        <Slider Name="MaximumSlider" Style="{StaticResource FovSlider}" ValueChanged="Slider_ValueChanged"
                AutomationProperties.Name="{l:Tr Fov.Maximum}"/>

        <TextBlock Name="StatusText" Margin="0,14,0,0" Foreground="#a2a2a2" FontSize="13" TextWrapping="Wrap"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Name="ResetButton" Height="34" FontSize="14" FontWeight="SemiBold" Background="#494949" Foreground="#f2f2f2"
                    Content="{l:Tr Fov.Reset}" ToolTip="{l:Tr Fov.ResetTooltip}" Click="Reset_Click"/>
            <Button Name="SaveButton" Grid.Column="2" Height="34" FontSize="14" FontWeight="Bold" Background="#C25E0C" Foreground="#f2f2f2"
                    Content="{l:Tr Fov.Save}" Click="Save_Click" IsDefault="True"/>
            <Button Grid.Column="4" Height="34" FontSize="14" FontWeight="SemiBold" Background="#494949" Foreground="#f2f2f2"
                    Content="{l:Tr Common.Close}" Click="Close_Click" IsCancel="True"/>
        </Grid>

        <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Right" FontSize="12" Name="RemovePanel">
                <Hyperlink Foreground="#a2a2a2" Click="Remove_Click"><Run Text="{l:Tr Fov.Remove}"/></Hyperlink>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="#808080" TextWrapping="Wrap">
                <Run Text="{l:Tr Fov.Credit}"/>
                <Hyperlink Foreground="#F28C1E" Click="ModPage_Click"><Run Name="CreditRun"/></Hyperlink>
            </TextBlock>
        </DockPanel>
    </StackPanel>
</Window>
