<Window x:Class="SparkingUnverum.UI.UpdateFileBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="Majin Unverum" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        ResizeMode="NoResize" Width="680"
        Background="#202020" ShowActivated="True" SizeToContent="Height">
    <Window.Resources>
        <DataTemplate x:Key="FileTemplate">
            <Border Margin="5" CornerRadius="3" Background="#353535" Padding="6">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                    <Grid Margin="6,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Tags}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOld}" Value="True">
                                                <Setter Property="Foreground" Value="#FF8A65"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="17" FontWeight="Bold" Foreground="#f2f2f2" TextTrimming="CharacterEllipsis" Text="{Binding Path=File.FileName}"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" FontSize="13" Foreground="#a2a2a2" Text="{Binding Path=Details}"/>
                        <TextBlock Grid.Row="2" FontSize="13" Foreground="#c2c2c2" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Text="{Binding Path=File.Description}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding File.HasDescription}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </CheckBox>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Name="PreviewImage" Grid.Row="0" MaxHeight="200" Stretch="Uniform" Margin="0,0,0,6" Visibility="Collapsed"/>
        <TextBlock Grid.Row="1" Padding="10,2,10,2" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Name="TitleBox"/>
        <TextBlock Grid.Row="2" Margin="10,2,10,6" Foreground="#c2c2c2" HorizontalAlignment="Center" TextAlignment="Center" FontSize="14" TextWrapping="Wrap" Name="SubtitleBox"/>
        <Grid Grid.Row="3" Name="FolderPanel" Margin="5,0,5,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Files.FolderName}" Foreground="#f2f2f2" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Name="ModFolderNameTextBox" Grid.Column="1" Height="26" Background="#303030" BorderBrush="#353535" Foreground="#f2f2f2" VerticalContentAlignment="Center"/>
        </Grid>
        <ListView MaxHeight="420" Style="{StaticResource ListviewStyle}" Name="FileList" Grid.Row="4" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource FileTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="false"/>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <Grid Grid.Row="5" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Margin="5" Height="40" CornerRadius="2" Background="{StaticResource AccentBrush}">
                <Button Margin="2" Name="DownloadSelectedButton" Content="{l:Tr Files.DownloadSelected}" FontSize="16" FontWeight="Bold" Foreground="#f2f2f2" Click="DownloadSelectedButton_Click" IsDefault="True"/>
            </Border>
            <Button Grid.Column="1" Margin="5" Height="40" Name="DownloadAllButton" Content="{l:Tr Files.DownloadAll}" FontSize="16" FontWeight="Bold" Background="#494949" Foreground="#f2f2f2" Click="DownloadAll_Click"/>
            <Button Grid.Column="2" Margin="5" Height="40" Name="CancelButton" Content="{l:Tr Common.Cancel}" FontSize="16" FontWeight="Bold" Background="#494949" Foreground="#f2f2f2" Click="CancelButton_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
