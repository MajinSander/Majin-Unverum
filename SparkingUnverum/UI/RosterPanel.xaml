<UserControl x:Class="SparkingUnverum.UI.RosterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:l="clr-namespace:SparkingUnverum"
             xmlns:ui="clr-namespace:SparkingUnverum.UI"
             Background="#202020" PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="HiddenWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A character as in the select screen of the game -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type ui:RosterTile}">
            <Border x:Name="Tile" Width="104" CornerRadius="5" Background="#262626" ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="5,5,0,0" Background="#303030">
                        <TextBlock Text="{Binding Initials}" FontSize="26" FontWeight="Bold" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="5,5,0,0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill" AlignmentY="Top"/>
                        </Border.Background>
                    </Border>
                    <Border Margin="4" Padding="5,1" CornerRadius="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding HasModCostumes, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding CostumesBadge}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Margin="4" Padding="4,1" CornerRadius="3" Background="#2D6FA3" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:Tr Roster.NewBadge}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                    </Border>
                    <Border Margin="4" Padding="5,1" CornerRadius="3" Background="#B23A2A" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Visibility="{Binding HasClashes, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <fa5:ImageAwesome Icon="Solid_ExclamationTriangle" Height="9" Foreground="White" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ClashCount}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="4" Width="16" Height="16" CornerRadius="8" Background="#2D6FA3" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="?" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="5,2,5,2" Foreground="#f2f2f2" FontSize="11" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.45"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TileContainer" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Margin="3" Padding="1" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#5a5a5a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Frame" Property="Background" Value="#3a2a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A costume of the character -->
        <DataTemplate DataType="{x:Type ui:CostumeCard}">
            <Border x:Name="Card" Width="128" Margin="4" CornerRadius="5" Background="#262626" BorderThickness="2" BorderBrush="Transparent" ToolTip="{Binding Tooltip}">
                <StackPanel>
                    <Grid Height="112">
                        <Border CornerRadius="4,4,0,0" Background="#303030">
                            <TextBlock Text="{Binding Number}" FontSize="34" FontWeight="Bold" Foreground="#4a4a4a" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="4,4,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" AlignmentY="Top"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" Margin="6,4,6,0" Foreground="#f2f2f2" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Origin" Text="{Binding Origin}" Margin="6,1,6,0" Foreground="#909090" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Note" Text="{Binding Note}" Margin="6,1,6,5" Foreground="#a2a2a2" FontSize="10.5" TextWrapping="Wrap" MaxHeight="30"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource HiddenWhenEmpty}"/>
                    <Border Height="5"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FromMod}" Value="True">
                    <Setter TargetName="Origin" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRivals}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#D9534F"/>
                    <Setter TargetName="Note" Property="Foreground" Value="#FF8A65"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Mods fighting over something of the character, one click keeps one -->
        <DataTemplate DataType="{x:Type ui:RosterClashRow}">
            <Border Margin="0,3" Padding="10,7" CornerRadius="4" Background="#2f2420">
                <StackPanel>
                    <TextBlock Text="{Binding Text}" Foreground="#f2f2f2" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Foreground="#a2a2a2" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource HiddenWhenEmpty}"/>
                    <ItemsControl ItemsSource="{Binding Choices}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,6,4">
                                    <Button Margin="1" Padding="10,3" FontSize="12" FontWeight="SemiBold" Foreground="#f2f2f2" Content="{Binding Label}"
                                            ToolTip="{Binding Tooltip}" Click="Keep_Click"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A mod of the character: what it does to it, on or off here -->
        <DataTemplate DataType="{x:Type ui:RosterModRow}">
            <Border Margin="0,3" Padding="6" CornerRadius="4" Background="#262626" ToolTip="{l:Tr Roster.ModRowTooltip}" MouseLeftButtonDown="ModRow_MouseDown">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,8,0"
                              ToolTip="{l:Tr Categories.EnabledTooltip}"/>
                    <Border DockPanel.Dock="Left" Width="68" Height="38" CornerRadius="3" Background="#333333">
                        <Border CornerRadius="3">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="#f2f2f2" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding What}" Foreground="#a2a2a2" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" MinWidth="380"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- Live filter and options -->
        <Grid Grid.ColumnSpan="3" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Height="35">
                <TextBox x:Name="SearchBox" AutomationProperties.Name="{l:Tr Roster.SearchHint}" Background="#353535" Foreground="#f2f2f2" BorderBrush="#353535" Padding="5,0,30,0" FontSize="15"
                         VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                <TextBlock Padding="8,0,5,0" Foreground="#909090" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="14" Text="{l:Tr Roster.SearchHint}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text.IsEmpty}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <fa5:ImageAwesome Icon="Solid_Times" Foreground="#f2f2f2" HorizontalAlignment="Right" Margin="0,0,10,0" Height="14" Cursor="Hand"
                                  PreviewMouseLeftButtonDown="ClearSearch_Click">
                    <fa5:ImageAwesome.Style>
                        <Style TargetType="fa5:ImageAwesome">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text.IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </fa5:ImageAwesome.Style>
                </fa5:ImageAwesome>
            </Grid>
            <ComboBox x:Name="ShowBox" Grid.Column="1" Width="220" Height="35" Margin="8,0,0,0" FontSize="14" SelectionChanged="ShowBox_SelectionChanged">
                <ComboBoxItem IsSelected="True" Content="{l:Tr Roster.ShowWithMods}"/>
                <ComboBoxItem Content="{l:Tr Roster.ShowClashes}"/>
                <ComboBoxItem Content="{l:Tr Roster.ShowAll}"/>
            </ComboBox>
            <Border Grid.Column="2" Margin="14,0,0,0" Height="35" CornerRadius="3" Background="{StaticResource AccentBrush}">
                <Button Margin="2" Padding="14,0" FontSize="15" FontWeight="SemiBold" Foreground="#f2f2f2" Content="{l:Tr Categories.Close}" Click="Close_Click"/>
            </Border>
        </Grid>

        <!-- Where the data comes from -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="2,0,0,4">
            <TextBlock x:Name="ResultText" Foreground="#c2c2c2" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock x:Name="ToolLink" DockPanel.Dock="Right" Margin="12,0,2,0" FontSize="13" VerticalAlignment="Center" Cursor="Hand" Foreground="{StaticResource AccentBrush}"
                       Text="{l:Tr Roster.OpenTool}" ToolTip="{l:Tr Roster.OpenToolTooltip}" MouseLeftButtonUp="OpenTool_Click" TextDecorations="Underline" Visibility="Collapsed"/>
            <TextBlock x:Name="SourceText" Foreground="#7FC8FF" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Every character -->
        <Border Grid.Row="2" Background="#1a1a1a" BorderBrush="#424242" BorderThickness="1">
            <Grid>
                <ListBox x:Name="TileList" ItemTemplate="{StaticResource TileTemplate}" ItemContainerStyle="{StaticResource TileContainer}" ItemsPanel="{StaticResource WrapItems}"
                         SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="2" AutomationProperties.Name="{l:Tr Roster.Characters}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                         SelectionChanged="TileList_SelectionChanged"/>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Foreground="#909090" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="30" IsHitTestVisible="False"/>
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                    <fa5:ImageAwesome Foreground="{StaticResource AccentBrush}" Icon="Solid_Spinner" Height="44" Spin="True" SpinDuration="2"/>
                    <TextBlock Text="{l:Tr Roster.Loading}" Foreground="#c2c2c2" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- The chosen character -->
        <Border Grid.Row="2" Grid.Column="2" Background="#1a1a1a" BorderBrush="#424242" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="NoSelection" Text="{l:Tr Roster.PickOne}" Foreground="#909090" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"/>
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="12,10,12,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Width="96" Height="150" CornerRadius="5" Background="#303030">
                                <Border CornerRadius="5">
                                    <Border.Background>
                                        <ImageBrush x:Name="DetailPortrait" Stretch="UniformToFill" AlignmentY="Top"/>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                <TextBlock x:Name="DetailName" Foreground="#f2f2f2" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailId" Foreground="#808080" FontSize="12" Margin="0,2,0,0"/>
                                <TextBlock x:Name="DetailSlot" Foreground="#7FC8FF" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource HiddenWhenEmpty}"/>
                                <TextBlock x:Name="DetailSummary" Foreground="#c2c2c2" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource HiddenWhenEmpty}"/>
                                <Button x:Name="SearchStoreButton" Margin="0,10,0,0" Padding="10,4" HorizontalAlignment="Left" Foreground="#f2f2f2" FontSize="12.5"
                                        Click="SearchStore_Click" ToolTip="{l:Tr Roster.SearchStoreTooltip}" AutomationProperties.Name="{l:Tr Roster.SearchStore}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa5:ImageAwesome Icon="Solid_Search" Height="11" Foreground="#f2f2f2" Margin="0,0,7,0"/>
                                        <TextBlock Text="{l:Tr Roster.SearchStore}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="ClashSection" Margin="0,14,0,0">
                            <TextBlock Text="{l:Tr Roster.Clashes}" FontSize="17" FontWeight="Bold" Foreground="#FF8A65" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="ClashList"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                            <TextBlock Text="{l:Tr Roster.Costumes}" FontSize="17" FontWeight="Bold" Foreground="#f2f2f2"/>
                            <TextBlock x:Name="CostumeCount" Foreground="#a2a2a2" Margin="8,0,0,2" FontSize="13" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock x:Name="NoCostumes" Foreground="#909090" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,4" Style="{StaticResource HiddenWhenEmpty}"/>
                        <ItemsControl x:Name="CostumeList" ItemsPanel="{StaticResource WrapItems}" Margin="-4,0,-4,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                            <TextBlock Text="{l:Tr Roster.Mods}" FontSize="17" FontWeight="Bold" Foreground="#f2f2f2"/>
                            <TextBlock x:Name="ModCount" Foreground="#a2a2a2" Margin="8,0,0,2" FontSize="13" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock x:Name="NoMods" Text="{l:Tr Roster.NoMods}" Foreground="#909090" FontSize="12" Margin="2,0,2,4"/>
                        <ItemsControl x:Name="ModList"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
