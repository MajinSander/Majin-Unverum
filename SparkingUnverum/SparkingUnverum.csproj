<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SparkingUnverum</RootNamespace>
    <AssemblyName>MajinUnverum</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Majin Unverum</Product>
    <AssemblyTitle>Majin Unverum</AssemblyTitle>
    <Description>Mod manager for DRAGON BALL Sparking! ZERO</Description>
    <Authors>Majin</Authors>
    <Company>Majin</Company>
    <Copyright>Majin</Copyright>
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
    <InformationalVersion>2.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>disable</Nullable>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sig/UTOC bypass that gets installed next to SparkingZERO-Win64-Shipping.exe -->
    <EmbeddedResource Include="Resources\Patch\dsound.dll" LogicalName="Patch/dsound.dll" />
    <EmbeddedResource Include="Resources\Patch\plugins\DBSparkingZeroUTOCBypass.asi" LogicalName="Patch/plugins/DBSparkingZeroUTOCBypass.asi" />
    <!-- SparkingFOV, a mod by another author put in the game by the FOV tab (see SparkingFov.cs) -->
    <EmbeddedResource Include="Resources\SparkingFOV\version.dll" LogicalName="SparkingFOV/version.dll" />
    <EmbeddedResource Include="Resources\SparkingFOV\DBSZ_SparkingFOV.ini" LogicalName="SparkingFOV/DBSZ_SparkingFOV.ini" />
    <!-- Translations -->
    <EmbeddedResource Include="Lang\es.json" LogicalName="Lang/es.json" />
    <EmbeddedResource Include="Lang\en.json" LogicalName="Lang/en.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome5" Version="2.1.11" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GameBanana.png" />
    <Resource Include="Assets\Icons\DBSZ.jpg" />
    <Resource Include="Assets\RobotoMono-Regular.ttf" />
    <Resource Include="Assets\preview.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- UE4SS travels inside the program (it also has to fit in the single .exe), extracted when a mod needs it -->
    <EmbeddedResource Include="Dependencies\ue4ss\**\*" LogicalName="ue4ss/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
